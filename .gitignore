# Virtual environment
.venv/

# Environment variables
.env

# Python cache
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Streamlit secrets
.streamlit/secrets.toml

# Data (do not commit — see Building Data Genome Project 2)
data/
Datasets/

# Pipeline outputs
data/processed/

# Generated report
outputs/

# Inbox: dropped data files and generated outputs are runtime artifacts. Keep
# only the folder (.gitkeep); the stable demo reports live under samples/.
inbox/*.csv
inbox/results/
inbox/mapping_report.md

# Local hook state (per-machine task-completion tracking)
.kiro/specs/heat-check/.task_count

# Local MCP settings (may contain machine-specific absolute paths). The portable
# template lives at docs/mcp.example.json.
.kiro/settings/mcp.json
